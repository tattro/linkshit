# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://user:password@localhost:5432/linksh

# Public URL of the site, used in emails and QR codes (optional; inferred from the request)
NEXT_PUBLIC_SITE_URL=https://linksh.it

# Comma-separated emails that get the /admin panel
ADMIN_EMAILS=you@example.com

# Email via https://resend.com (password resets + email verification).
# Without a key, emails are only logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="linksh.it <hello@linksh.it>"

# Optional: Google Safe Browsing API key to block malware/phishing links
GOOGLE_SAFE_BROWSING_KEY=
